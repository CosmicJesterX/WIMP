rm -rf tmp-src
git add .
git commit -m "chore: import mIRCat UI-only mock"

# 3) Create a new empty project in GitLab (via UI) and add it as remote (SSH recommended)
git remote add origin git@gitlab.com:YOUR_GROUP/mircat-ui-mock.git

# 4) Push
git branch -M main
git push -u origin main
